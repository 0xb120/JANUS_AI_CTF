# JANUS legge una sola variabile ambiente applicativa:
# JANUS_SECRET_KEY
#
# Il launcher corrente non carica automaticamente file .env. Questo file è un
# riferimento: impostare la variabile nell'ambiente del processo oppure lasciare
# il valore assente affinché JANUS generi janus.key nel DataDir.
#
# Formati accettati:
# - testo raw di almeno 32 byte;
# - hex:<almeno 64 cifre esadecimali>;
# - base64:<valore decodificato di almeno 32 byte>.
#
# Non commettere una chiave reale e non cambiarla durante un evento Score: il
# database deve rimanere associato alla stessa chiave.

JANUS_SECRET_KEY=

# Modalità, provider, modelli, speech, percorsi, host e porta sono configurati
# tramite i file YAML e gli argomenti CLI/Start-Janus, non tramite .env.

# --- Docker Compose (docs/DOCKER.md) ----------------------------------------
# docker compose legge automaticamente .env dalla root del repository. Le
# variabili seguenti sono usate solo dallo stack containerizzato; i valori
# commentati sono i default.
#
# JANUS_MODE=stand                      # stand | score
# JANUS_LLM_PROVIDER=ollama             # ollama | mock
# JANUS_LLM_MODEL=qwen3:4b-instruct
# JANUS_STT_PROVIDER=faster_whisper     # faster_whisper | disabled
# JANUS_STT_MODEL=small                 # tiny | base | small | medium
# JANUS_TTS_PROVIDER=piper              # piper | disabled
# JANUS_PIPER_VOICE_IT=it_IT-paola-medium
# JANUS_PIPER_VOICE_EN=en_US-lessac-medium
# JANUS_BIND_ADDRESS=127.0.0.1
# JANUS_PORT=8000
# OLLAMA_VERSION=latest
# OLLAMA_KEEP_ALIVE=24h
# OLLAMA_NUM_PARALLEL=1
#
# --- Hugging Face Inference Providers (opzionale, al posto di Ollama) -------
# Letti anche dalla CLI/launcher con --llm-provider huggingface. Su host vanno
# esportati nell'ambiente; con Docker basta questo file. Vedere README.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.hf.yml
# HF_TOKEN=
# HF_BILL_TO=
# JANUS_HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
#
# --- Modalità online su Internet (docker-compose.public.yml, docs/DOCKER.md) --
# docker compose -f docker-compose.yml -f docker-compose.public.yml up -d --build
# JANUS_PUBLIC_HOST e JANUS_ACCESS_CODES sono obbligatorie con l'override public.
#
# JANUS_PUBLIC_HOST=ctf.example.com     # nome DNS che punta a questo host
# JANUS_ACCESS_CODES=                   # codici evento separati da virgola, >= 8 caratteri
# JANUS_TLS=acme                        # acme (Let's Encrypt, richiede 80/443) | internal
# JANUS_HTTP_PORT=80
# JANUS_HTTPS_PORT=443
# JANUS_SUBNET=172.30.57.0/24           # subnet Compose; JANUS_CADDY_IP deve ricaderci
# JANUS_CADDY_IP=172.30.57.10           # indirizzo fisso di Caddy (proxy fidato)
# CADDY_VERSION=2
#
# Variante con proxy esterno (docker-compose.proxy.yml): servono JANUS_PUBLIC_HOST,
# JANUS_ACCESS_CODES e JANUS_TRUSTED_PROXIES (IP/CIDR del proxy).
# JANUS_TRUSTED_PROXIES=10.0.0.5
#
# Per usare i comandi `docker compose` senza -f:
# COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
